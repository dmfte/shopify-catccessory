                            "font_size_h3_mobile": 0,
                            "font_size_h4_mobile": 0,
                            "font_size_h5_mobile": 0,
                            "font_size_h6_mobile": 0,
                            "padding_top_mobile": 0,
                            "padding_bottom_mobile": 0,
                            "padding_left_mobile": 0,
                            "padding_right_mobile": 0
                          },
                          "blocks": {}
                        },
                        "spark_paragraph_2": {
                          "type": "blk_richtext",
                          "name": "Paragraph 2",
                          "settings": {
                            "richtext": "<p>What began as one hand-sewn collar for one particular cat became a small batch of pieces for friends, then a waitlist, then a studio. The name came later. The philosophy — comfort first, nothing wasted, nothing generic — was there from the very first stitch.</p>",
                            "p_style": "paragraph",
