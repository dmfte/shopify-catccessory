                        "spark_paragraph_1": {
                          "type": "blk_richtext",
                          "name": "Paragraph 1",
                          "settings": {
                            "richtext": "<p>Long before Catcessory had a name, it had a cat: Mochi, a rescue with very particular taste and zero patience for anything scratchy, ill-fitting, or plain. Every collar we bought her, she rejected. Every bed, ignored. So we started making our own — cutting patterns on the kitchen table, testing fabrics against her (very discerning) approval.</p>",
                            "p_style": "paragraph",
                            "font_size_p": 0,
                            "font_size_h1": 0,
                            "font_size_h2": 0,
                            "font_size_h3": 0,
