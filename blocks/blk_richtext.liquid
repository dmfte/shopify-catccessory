{% liquid
  assign full_width_mobile = block.settings.full_width
  assign alignment_mobile = block.settings.alignment
  if block.settings.full_width_mobile == 'on'
    assign full_width_mobile = true
  elsif block.settings.full_width_mobile == 'off'
    assign full_width_mobile = false
  endif
  if block.settings.alignment_mobile != 'default'
    assign alignment_mobile = block.settings.alignment_mobile
  endif

  assign font_size_tags = 'p,h1,h2,h3,h4,h5,h6' | split: ','
%}
{% style %}
  :root {
    --color-brand-primary: {{ block.settings.font_color }};
  }
  #shopify-block-{{ block.id }} {
    color: var(--color-brand-primary);
    {% if block.settings.full_width %}
        width: 100%;
        text-align: {{ block.settings.alignment }};
    {% endif %}
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
  }
  #shopify-block-{{ block.id }} > * {
    margin: 0;
  }
  {% if block.settings.p_style == 'eyebrow' %}
  #shopify-block-{{ block.id }} p {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    {% if block.settings.font_size_p == 0 %}
    font-size: 0.75rem;
    {% endif %}
  }
  {% endif %}
  {% for tag in font_size_tags %}
    {% assign size_key = 'font_size_' | append: tag %}
    {% if block.settings[size_key] > 0 %}
  #shopify-block-{{ block.id }} {{ tag }} {
    font-size: {{ block.settings[size_key] }}px;
  }
    {% endif %}
  {% endfor %}
  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      {% if full_width_mobile %}
          width: 100%;
          text-align: {{ alignment_mobile }};
      {% else %}
          width: auto;
          text-align: inherit;
      {% endif %}
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
    }
    {% for tag in font_size_tags %}
      {% assign size_key = 'font_size_' | append: tag | append: '_mobile' %}
      {% if block.settings[size_key] > 0 %}
    #shopify-block-{{ block.id }} {{ tag }} {
      font-size: {{ block.settings[size_key] }}px;
    }
      {% endif %}
    {% endfor %}
  }
{% endstyle %}
{{
  block.settings.richtext
  | replace: '::', '<br>'
  | replace: 'u^', '<u>'
  | replace: 'u%', '</u>'
  | replace: '~^', '<s>'
  | replace: '~$', '</s>'
  | replace: 's^', '<sup>'
  | replace: 's$', '</sup>'
  | replace: 'b^', '<sub>'
  | replace: 'b$', '</sub>'
}}
