{% liquid
  for scheme in settings.color_schemes
    if scheme.id == 'scheme-1'
      assign cat_scheme = scheme
      break
    endif
  endfor
%}
{% style %}
  #shopify-block-{{ block.id }} {
    {% render 'blk-scheme-vars', scheme: cat_scheme %}
    --cat-path-filled-rest: from 11px 15px, curve by 2px 0px with 1px 3px, close, move to 12px 13px, arc by -2px 0px of 1px ccw, arc by 2px 0px of 1px ccw, move to 19px 13px, arc by 2px 0px of 1px ccw, arc by -2px 0px of 1px ccw, move to 16px 16px, line to 19px 16px, move to 16px 18px, line to 19px 19px, move to 26px 11px, curve by -3px -7px with 0px -3px / -1px -5px, line by -3px 3px, curve by -5px 0px with -2px 0px / -3px 0px, line by -3px -3px, curve by -6px 13px with -3px 4px / -6px 9px, curve by 4px 10px with 0px 4px / 2px 8px, hline to 18px, hline to 10px, curve by -7px 2px with -6px 0px / -7px 0px, curve by 4px 2px with 0px 2px / 1px 2px, hline to 18px, hline to 7px, curve by -3px 2px with -1px 0px / -3px 0px, curve by 3px 3px with 0px 3px / 2px 3px, hline by calc({{ block.settings.width }} - 30px), curve by 8px -3px with 4px 0px / 6px -1px, curve by 2px -8px with 2px -2px / 3px -5px, curve by 3px -12px with 3px -4px / 4px -7px, curve by -9px -9px with -2px -5px / -3px -6px, curve by -7px 0px with -3px -1px / -5px -2px, curve by 3px 5px with -2px 4px / 3px 5px, curve by 8px 3px with 5px 1px / 5px 1px, curve by 1px 6px with 2px 2px / 2px 5px, curve by -3px -5px with 0px -2px / -2px -4px, curve by -9px -2px with -2px -2px / -5px -2px, close, move by -19px 3px, line by -3px -1px, move by 2px 3px, line by -2px 0px;
    --cat-path-filled-waggle: from 11px 15px, curve by 2px 0px with 1px 3px, close, move to 12px 13px, arc by -2px 0px of 1px ccw, arc by 2px 0px of 1px ccw, move to 19px 13px, arc by 2px 0px of 1px ccw, arc by -2px 0px of 1px ccw, move to 16px 16px, line to 19px 16px, move to 16px 18px, line to 19px 19px, move to 26px 11px, curve by -3px -7px with 0px -3px / -1px -5px, line by -3px 3px, curve by -5px 0px with -2px 0px / -3px 0px, line by -3px -3px, curve by -6px 13px with -3px 4px / -6px 9px, curve by 4px 10px with 0px 4px / 2px 8px, hline to 18px, hline to 10px, curve by -7px 2px with -6px 0px / -7px 0px, curve by 4px 2px with 0px 2px / 1px 2px, hline to 18px, hline to 7px, curve by -3px 2px with -1px 0px / -3px 0px, curve by 3px 3px with 0px 3px / 2px 3px, hline by calc({{ block.settings.width }} - 30px), curve by 8px -3px with 4px 0px / 6px -1px, curve by 2px -8px with 2px -2px / 3px -5px, /* Tail movement begins here */ curve by 7px -7px with 1px -2px / 5px -5px, curve by 5px -10px with 3px -3px / 4px -6px, curve by -2px -4px with 1px -2px / 0px -4px, curve by -3px 5px with -3px 0px / -2px 2px, curve by -3px 5px with -1px 2px / -1px 3px, curve by -5px 4px with -3px 3px / -4px 3px, curve by -3px -5px with 0px -2px / -2px -4px, curve by -9px -2px with -2px -2px / -5px -2px, close, move by -19px 3px, line by -3px -1px, move by 2px 3px, line by -2px 0px;
    width: {{ block.settings.width }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
    }
  }
{% endstyle %}

{% stylesheet %}
  .cat-btn {
    display: block;
    position: relative;
    width: 100%;
    height: 40px;
    text-decoration: none;

    & .cat-shape {
      position: absolute;
      top: 0;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: 8px;
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      font-size: 16px;
      line-height: 1;
      background-color: var(--color-primary-button-background);
      color: var(--color-primary-button-text);
      transition: background-color 150ms ease, color 150ms ease;
      clip-path: shape(var(--cat-path-filled-rest));
    }

    &:hover {
      & .cat-shape {
        background-color: var(--color-primary-button-hover-background);
        color: var(--color-primary-button-hover-text);
        animation: cat-tail-waggle 600ms ease-in-out;
      }
    }

    &.cat-btn--secondary {
      & .cat-shape {
        background-color: var(--color-secondary-button-background);
        color: var(--color-secondary-button-text);
      }

      &:hover .cat-shape {
        background-color: var(--color-secondary-button-hover-background);
        color: var(--color-secondary-button-hover-text);
      }
    }
  }

  @keyframes cat-tail-waggle {
    0% {
      clip-path: shape(var(--cat-path-filled-rest));
    }
    50% {
      clip-path: shape(var(--cat-path-filled-waggle));
    }
    100% {
      clip-path: shape(var(--cat-path-filled-rest));
    }
  }
{% endstylesheet %}
<a
  href="{{ block.settings.link | default: '#' }}"
  class="cat-btn{% if block.settings.style == 'secondary' %} cat-btn--secondary{% endif %}{% if block.settings.animate_tail %} cat-btn--animated{% endif %}"
  {% if block.settings.open_in_new_tab %}
    target="_blank" rel="noopener"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <span class="cat-shape">{{ block.settings.label | escape }}</span>
</a>

{% schema %}
{
  "name": "Cat button",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Size and position"
    },
    {
      "type": "text",
      "id": "width",
      "label": "Width",
      "default": "100%",
      "info": "Use any CSS width unit: px, %, rem, etc."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary",
      "info": "Secondary uses the theme's secondary button colors for lower-emphasis actions."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12,
      "info": "Measured on the cat's native canvas, so it scales with the button size"
    },
    {
      "type": "checkbox",
      "id": "animate_tail",
      "label": "Wag tail on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Cat button",
      "category": "Custom blocks"
    }
  ]
}
{% endschema %}
