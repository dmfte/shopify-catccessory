{% liquid
  case block.settings.alignment
    when 'left'
      assign cat_margin = block.settings.margin_vertical | append: 'px auto ' | append: block.settings.margin_vertical | append: 'px 0'
    when 'right'
      assign cat_margin = block.settings.margin_vertical | append: 'px 0 ' | append: block.settings.margin_vertical | append: 'px auto'
    else
      assign cat_margin = block.settings.margin_vertical | append: 'px auto'
  endcase
%}
{% style %}
  #shopify-block-{{ block.id }} {
    --w: {{ block.settings.width }};
    --h: {{ block.settings.height }};
    --cat-margin: {{ cat_margin }};
    --cat-bg: {{ block.settings.background_color }};
    --cat-bg-hover: {{ block.settings.hover_background_color }};
    --cat-text: {{ block.settings.text_color }};
    --cat-font-size: {{ block.settings.font_size }}px;
  }
{% endstyle %}
<a
  href="{{ block.settings.link | default: '#' }}"
  class="cat-btn{% if block.settings.animate_tail %} cat-btn--animated{% endif %}"
  {% if block.settings.open_in_new_tab %}
    target="_blank" rel="noopener"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <span class="cat-shape">{{ block.settings.label | escape }}</span>
</a>

{% stylesheet %}
  .cat-btn {
    display: block;
    position: relative;
    width: calc(var(--w) * 1px);
    height: calc(var(--h) * 1px);
    margin: var(--cat-margin);
    text-decoration: none;
  }

  .cat-shape {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 121px;
    height: 35px;
    transform-origin: top left;
    transform: scale(calc(var(--w) / 121), calc(var(--h) / 35));
    background-color: var(--cat-bg);
    box-sizing: border-box;
    padding-bottom: 6px;
    font-size: var(--cat-font-size);
    line-height: 1;
    color: var(--cat-text);
    transition: background-color 150ms ease;
    clip-path: path(
      "M 88 10 L 25 10 C 25 7 24 5 22 3 L 19 6 C 17 6 16 6 14 6 L 11 3 C 8 7 5 12 5 16 C 5 20 7 24 8 26 L 17 26 L 8 26 C 3 26 2 26 2 28 C 2 30 3 30 6 30 L 17 30 L 6 30 C 5 30 3 30 3 32 C 3 35 5 35 6 35 L 92 35 C 96 35 98 34 100 32 C 102 30 103 27 102 24 C 105 20 106 17 105 12 C 103 7 102 6 96 3 C 93 2 91 1 89 3 C 87 7 92 8 92 8 C 97 9 97 9 100 11 C 102 13 102 16 101 17 C 101 15 99 13 98 12 C 96 10 93 10 89 10 Z M 6 13 L 3 12 M 5 15 L 3 15 M 15 15 L 18 15 M 15 17 L 18 18 M 10 14 Q 11 17 12 14 Z M 11 12 A 1 1 0 0 0 9 12 A 1 1 0 0 0 11 12 M 18 12 A 1 1 0 0 0 20 12 A 1 1 0 0 0 18 12"
    );
  }

  .cat-btn:hover .cat-shape,
  .cat-btn:focus-visible .cat-shape {
    background-color: var(--cat-bg-hover);
  }

  .cat-btn--animated:hover .cat-shape {
    animation: cat-tail 500ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-btn--animated:hover .cat-shape {
      animation: none;
    }
  }

  @keyframes cat-tail {
    0% {
      clip-path: path(
        "M 88 10 L 25 10 C 25 7 24 5 22 3 L 19 6 C 17 6 16 6 14 6 L 11 3 C 8 7 5 12 5 16 C 5 20 7 24 8 26 L 17 26 L 8 26 C 3 26 2 26 2 28 C 2 30 3 30 6 30 L 17 30 L 6 30 C 5 30 3 30 3 32 C 3 35 5 35 6 35 L 92 35 C 96 35 98 34 100 32 C 102 30 103 27 102 24 C 105 20 106 17 105 12 C 103 7 102 6 96 3 C 93 2 91 1 89 3 C 87 7 92 8 92 8 C 97 9 97 9 100 11 C 102 13 102 16 101 17 C 101 15 99 13 98 12 C 96 10 93 10 89 10 Z M 6 13 L 3 12 M 5 15 L 3 15 M 15 15 L 18 15 M 15 17 L 18 18 M 10 14 Q 11 17 12 14 Z M 11 12 A 1 1 0 0 0 9 12 A 1 1 0 0 0 11 12 M 18 12 A 1 1 0 0 0 20 12 A 1 1 0 0 0 18 12"
      );
    }
    50% {
      clip-path: path(
        "M 88 10 L 25 10 C 25 7 24 5 22 3 L 19 6 C 17 6 16 6 14 6 L 11 3 C 8 7 5 12 5 16 C 5 20 7 24 8 26 L 17 26 L 8 26 C 3 26 2 26 2 28 C 2 30 3 30 6 30 L 17 30 L 6 30 C 5 30 3 30 3 32 C 3 35 5 35 6 35 L 92 35 C 96 35 98 34 100 32 C 102 30 103 27 102 24 C 106 21 111 18 113 16 C 116 13 121 8 121 4 C 121 3 119 2 117 2 C 116 2 115 4 114 6 C 111 10 110 11 107 14 C 106 15 104 16 101 17 C 101 15 99 13 98 12 C 96 10 93 10 89 10 Z M 6 13 L 3 12 M 5 15 L 3 15 M 15 15 L 18 15 M 15 17 L 18 18 M 10 14 Q 11 17 12 14 Z M 11 12 A 1 1 0 0 0 9 12 A 1 1 0 0 0 11 12 M 18 12 A 1 1 0 0 0 20 12 A 1 1 0 0 0 18 12"
      );
    }
    100% {
      clip-path: path(
        "M 88 10 L 25 10 C 25 7 24 5 22 3 L 19 6 C 17 6 16 6 14 6 L 11 3 C 8 7 5 12 5 16 C 5 20 7 24 8 26 L 17 26 L 8 26 C 3 26 2 26 2 28 C 2 30 3 30 6 30 L 17 30 L 6 30 C 5 30 3 30 3 32 C 3 35 5 35 6 35 L 92 35 C 96 35 98 34 100 32 C 102 30 103 27 102 24 C 105 20 106 17 105 12 C 103 7 102 6 96 3 C 93 2 91 1 89 3 C 87 7 92 8 92 8 C 97 9 97 9 100 11 C 102 13 102 16 101 17 C 101 15 99 13 98 12 C 96 10 93 10 89 10 Z M 6 13 L 3 12 M 5 15 L 3 15 M 15 15 L 18 15 M 15 17 L 18 18 M 10 14 Q 11 17 12 14 Z M 11 12 A 1 1 0 0 0 9 12 A 1 1 0 0 0 11 12 M 18 12 A 1 1 0 0 0 20 12 A 1 1 0 0 0 18 12"
      );
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cat button",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Size and position"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 35,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "margin_vertical",
      "label": "Vertical margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ADD8E6"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Hover background color",
      "default": "#8FC7DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12,
      "info": "Measured on the cat's native canvas, so it scales with the button size"
    },
    {
      "type": "checkbox",
      "id": "animate_tail",
      "label": "Wag tail on hover",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Cat button",
      "category": "Custom blocks"
    }
  ]
}
{% endschema %}
