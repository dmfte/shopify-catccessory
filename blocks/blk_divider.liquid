{% style %}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;

    width: {{ block.settings.width }};
    display: flex;
    flex-direction: column;
    align-items: stretch;
    rule: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color }};

    & .empty {
      min-height: 0px;
      max-height: 0px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
      padding-left: {{ block.settings.padding_left_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
    }
  }
{% endstyle %}

<div class="empty"></div>
<div class="empty"></div>

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#777777"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "unit": "px",
      "min": 1,
      "max": 10,
      "default": 1
    },
    {
      "type": "select",
      "id": "style",
      "label": "Line style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "text",
      "id": "width",
      "label": "Width",
      "default": "100%",
      "info": "Accepts %, px, rem"
    },

    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "Custom blocks"
    }
  ]
}
{% endschema %}
