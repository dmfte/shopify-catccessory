{% liquid
  assign bg = block.settings.bg_color | default: 'transparent'
  assign bg_mobile = block.settings.bg_color_mobile | default: bg

  assign custom_width = block.settings.custom_width | strip
  assign width_check = custom_width | plus: 0 | append: ''
  if width_check == custom_width and custom_width != blank
    assign custom_width = custom_width | append: '%'
  endif
  assign custom_width = custom_width | escape
  if custom_width == blank
    assign custom_width = 'auto'
  endif

  assign width_mobile = block.settings.width_mobile
  if width_mobile == 'default'
    assign width_mobile = block.settings.width
    assign custom_width_mobile = custom_width
  else
    assign custom_width_mobile = block.settings.custom_width_mobile | strip
    assign width_check = custom_width_mobile | plus: 0 | append: ''
    if width_check == custom_width_mobile and custom_width_mobile != blank
      assign custom_width_mobile = custom_width_mobile | append: '%'
    endif
    assign custom_width_mobile = custom_width_mobile | escape
    if custom_width_mobile == blank
      assign custom_width_mobile = custom_width
    endif
  endif

  assign max_width = block.settings.max_width | strip
  assign width_check = max_width | plus: 0 | append: ''
  if width_check == max_width and max_width != blank
    assign max_width = max_width | append: '%'
  endif
  assign max_width = max_width | escape
  if max_width == blank
    assign max_width = 'none'
  endif

  assign min_width = block.settings.min_width | strip
  assign width_check = min_width | plus: 0 | append: ''
  if width_check == min_width and min_width != blank
    assign min_width = min_width | append: '%'
  endif
  assign min_width = min_width | escape
  if min_width == blank
    assign min_width = '0'
  endif

  assign max_width_mobile = block.settings.max_width_mobile | strip
  assign width_check = max_width_mobile | plus: 0 | append: ''
  if width_check == max_width_mobile and max_width_mobile != blank
    assign max_width_mobile = max_width_mobile | append: '%'
  endif
  assign max_width_mobile = max_width_mobile | escape
  if max_width_mobile == blank
    assign max_width_mobile = max_width
  endif

  assign min_width_mobile = block.settings.min_width_mobile | strip
  assign width_check = min_width_mobile | plus: 0 | append: ''
  if width_check == min_width_mobile and min_width_mobile != blank
    assign min_width_mobile = min_width_mobile | append: '%'
  endif
  assign min_width_mobile = min_width_mobile | escape
  if min_width_mobile == blank
    assign min_width_mobile = min_width
  endif

  case block.settings.horizontal_alignment
    when 'left'
      assign justify = 'flex-start'
    when 'center'
      assign justify = 'center'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'space-between'
  endcase

  case block.settings.vertical_alignment
    when 'top'
      assign align = 'flex-start'
    when 'middle'
      assign align = 'center'
    when 'bottom'
      assign align = 'flex-end'
    else
      assign align = 'stretch'
  endcase

  if block.settings.stack_mobile
    case block.settings.horizontal_alignment_mobile
      when 'left'
        assign align_mobile = 'flex-start'
      when 'center'
        assign align_mobile = 'center'
      when 'right'
        assign align_mobile = 'flex-end'
      else
        assign align_mobile = 'stretch'
    endcase
    case block.settings.vertical_alignment_mobile
      when 'middle'
        assign justify_mobile = 'center'
      when 'bottom'
        assign justify_mobile = 'flex-end'
      when 'space_between'
        assign justify_mobile = 'space-between'
      else
        assign justify_mobile = 'flex-start'
    endcase
  else
    case block.settings.horizontal_alignment_mobile
      when 'left'
        assign justify_mobile = 'flex-start'
      when 'center'
        assign justify_mobile = 'center'
      when 'right'
        assign justify_mobile = 'flex-end'
      else
        assign justify_mobile = 'space-between'
    endcase
    case block.settings.vertical_alignment_mobile
      when 'top'
        assign align_mobile = 'flex-start'
      when 'middle'
        assign align_mobile = 'center'
      when 'bottom'
        assign align_mobile = 'flex-end'
      else
        assign align_mobile = 'stretch'
    endcase
  endif

  assign display_desktop = 'flex'
  if block.settings.show_desktop == false
    assign display_desktop = 'none'
  endif

  assign display_mobile = 'flex'
  if block.settings.show_mobile == false
    assign display_mobile = 'none'
  endif
%}
{% style %}
  #shopify-block-{{ block.id }} {
    display: {{ display_desktop }};
    flex-direction: row;
    background-color: {{ bg }};
    gap: {{ block.settings.gap }}px;
    justify-content: {{ justify }};
    align-items: {{ align }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    border-radius: {{ block.settings.corner_radius }}px;
    min-height: {% if block.settings.min_height > 0 %}{{ block.settings.min_height }}px{% else %}auto{% endif %};
    max-width: {{ max_width }};
    min-width: {{ min_width }};
    {%- if block.settings.wrap %}
    flex-wrap: wrap;
    {%- endif %}
    {%- case block.settings.width %}
      {%- when 'fill' %}
    flex-grow: 1;
    flex-basis: 0;
      {%- when 'custom' %}
    width: {{ custom_width }};
    {%- endcase %}
  }

  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      display: {{ display_mobile }};
      background-color: {{ bg_mobile }};
      gap: {{ block.settings.gap_mobile }}px;
      justify-content: {{ justify_mobile }};
      align-items: {{ align_mobile }};
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
      max-width: {{ max_width_mobile }};
      min-width: {{ min_width_mobile }};
      {%- if block.settings.stack_mobile %}
        {%- if block.settings.reverse_mobile %}
      flex-direction: column-reverse;
        {%- else %}
      flex-direction: column;
        {%- endif %}
      {%- endif %}
      {%- case width_mobile %}
        {%- when 'fill' %}
      flex-grow: 1;
      flex-basis: 0;
        {%- when 'custom' %}
      width: {{ custom_width_mobile }};
      {%- endcase %}
    }
  }
{% endstyle %}
{% content_for 'blocks' %}

{% schema %}
{
  "name": "Flex row",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "bg_color_mobile",
      "label": "Background color (mobile)",
      "info": "Leave empty to use the same background color as desktop"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "space_between", "label": "Space between" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ],
      "default": "stretch"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "Allow items to wrap",
      "default": false,
      "info": "Items move to a new line when they don't fit"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "fit", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill",
      "info": "How this row shares space when placed inside another row or column"
    },
    {
      "type": "text",
      "id": "custom_width",
      "label": "Custom width",
      "default": "100%",
      "info": "Any CSS size: 50%, 300px, 40vw, calc(100% - 40px). Plain numbers are treated as %",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Max width",
      "info": "Any CSS size: 600px, 80vw, calc(100% - 40px). Plain numbers are treated as %. Leave empty for no limit"
    },
    {
      "type": "text",
      "id": "min_width",
      "label": "Min width",
      "info": "Any CSS size: 200px, 20vw. Plain numbers are treated as %. Leave empty for no minimum"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "0 means automatic"
    },
    {
      "type": "header",
      "content": "Paddings",
      "info": "In pixels"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right",
      "label": "Padding right",
      "default": 0
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "Stack vertically on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reverse_mobile",
      "label": "Reverse item order on mobile",
      "default": false,
      "info": "Only applies when items are stacked vertically on mobile",
      "visible_if": "{{ block.settings.stack_mobile }}"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between items",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "Horizontal alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "space_between", "label": "Space between" }
      ],
      "default": "left",
      "info": "When stacked, 'Space between' behaves as 'Stretch'"
    },
    {
      "type": "select",
      "id": "vertical_alignment_mobile",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "space_between", "label": "Space between" }
      ],
      "default": "top",
      "info": "When not stacked, 'Space between' behaves as 'Stretch'"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width",
      "options": [
        { "value": "default", "label": "Same as desktop" },
        { "value": "fill", "label": "Fill available space" },
        { "value": "fit", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "info": "Any CSS size: 50%, 300px, 40vw, calc(100% - 40px). Plain numbers are treated as %. Leave empty to use the desktop custom width",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "text",
      "id": "max_width_mobile",
      "label": "Max width",
      "info": "Any CSS size: 600px, 80vw. Plain numbers are treated as %. Leave empty to use the same max-width as desktop"
    },
    {
      "type": "text",
      "id": "min_width_mobile",
      "label": "Min width",
      "info": "Any CSS size: 200px, 20vw. Plain numbers are treated as %. Leave empty to use the same min-width as desktop"
    },
    {
      "type": "header",
      "content": "Paddings",
      "info": "In pixels"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left_mobile",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right_mobile",
      "label": "Padding right",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "blk_flex-row"
    },
    {
      "type": "blk_flex-col"
    },
    {
      "type": "blk_richtext"
    },
    {
      "type": "blk_background-image"
    },
    {
      "type": "blk_button-cat"
    },
    {
      "type": "blk_image"
    },
    {
      "type": "blk_divider"
    },
    {
      "type": "blk_product-card"
    }
  ],
  "presets": [
    {
      "name": "Flex row",
      "category": "Layout"
    }
  ]
}
{% endschema %}
