{% liquid
  assign inherit_color_scheme = block.settings.inherit_color_scheme
  if inherit_color_scheme == false
    assign scheme = block.settings.color_scheme
  endif

  assign custom_width = block.settings.custom_width | strip
  assign width_check = custom_width | plus: 0 | append: ''
  if width_check == custom_width and custom_width != blank
    assign custom_width = custom_width | append: '%'
  endif
  assign custom_width = custom_width | escape
  if custom_width == blank
    assign custom_width = 'auto'
  endif

  assign width_mobile = block.settings.width_mobile
  if width_mobile == 'default'
    assign width_mobile = block.settings.width
    assign custom_width_mobile = custom_width
  else
    assign custom_width_mobile = block.settings.custom_width_mobile | strip
    assign width_check = custom_width_mobile | plus: 0 | append: ''
    if width_check == custom_width_mobile and custom_width_mobile != blank
      assign custom_width_mobile = custom_width_mobile | append: '%'
    endif
    assign custom_width_mobile = custom_width_mobile | escape
    if custom_width_mobile == blank
      assign custom_width_mobile = custom_width
    endif
  endif

  assign max_width = block.settings.max_width | strip
  assign width_check = max_width | plus: 0 | append: ''
  if width_check == max_width and max_width != blank
    assign max_width = max_width | append: '%'
  endif
  assign max_width = max_width | escape
  if max_width == blank
    assign max_width = 'none'
  endif

  assign min_width = block.settings.min_width | strip
  assign width_check = min_width | plus: 0 | append: ''
  if width_check == min_width and min_width != blank
    assign min_width = min_width | append: '%'
  endif
  assign min_width = min_width | escape
  if min_width == blank
    assign min_width = '0'
  endif

  assign max_width_mobile = block.settings.max_width_mobile | strip
  assign width_check = max_width_mobile | plus: 0 | append: ''
  if width_check == max_width_mobile and max_width_mobile != blank
    assign max_width_mobile = max_width_mobile | append: '%'
  endif
  assign max_width_mobile = max_width_mobile | escape
  if max_width_mobile == blank
    assign max_width_mobile = max_width
  endif

  assign min_width_mobile = block.settings.min_width_mobile | strip
  assign width_check = min_width_mobile | plus: 0 | append: ''
  if width_check == min_width_mobile and min_width_mobile != blank
    assign min_width_mobile = min_width_mobile | append: '%'
  endif
  assign min_width_mobile = min_width_mobile | escape
  if min_width_mobile == blank
    assign min_width_mobile = min_width
  endif

  case block.settings.horizontal_alignment
    when 'left'
      assign justify = 'flex-start'
    when 'center'
      assign justify = 'center'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'space-between'
  endcase

  case block.settings.vertical_alignment
    when 'top'
      assign align = 'flex-start'
    when 'middle'
      assign align = 'center'
    when 'bottom'
      assign align = 'flex-end'
    else
      assign align = 'stretch'
  endcase

  if block.settings.stack_mobile
    case block.settings.horizontal_alignment_mobile
      when 'left'
        assign align_mobile = 'flex-start'
      when 'center'
        assign align_mobile = 'center'
      when 'right'
        assign align_mobile = 'flex-end'
      else
        assign align_mobile = 'stretch'
    endcase
    case block.settings.vertical_alignment_mobile
      when 'middle'
        assign justify_mobile = 'center'
      when 'bottom'
        assign justify_mobile = 'flex-end'
      when 'space_between'
        assign justify_mobile = 'space-between'
      else
        assign justify_mobile = 'flex-start'
    endcase
  else
    case block.settings.horizontal_alignment_mobile
      when 'left'
        assign justify_mobile = 'flex-start'
      when 'center'
        assign justify_mobile = 'center'
      when 'right'
        assign justify_mobile = 'flex-end'
      else
        assign justify_mobile = 'space-between'
    endcase
    case block.settings.vertical_alignment_mobile
      when 'top'
        assign align_mobile = 'flex-start'
      when 'middle'
        assign align_mobile = 'center'
      when 'bottom'
        assign align_mobile = 'flex-end'
      else
        assign align_mobile = 'stretch'
    endcase
  endif

  assign display_desktop = 'flex'
  if block.settings.show_desktop == false
    assign display_desktop = 'none'
  endif

  assign display_mobile = 'flex'
  if block.settings.show_mobile == false
    assign display_mobile = 'none'
  endif

  assign anchor_id = block.settings.anchor_id | strip | handleize
%}
{% style %}
  #shopify-block-{{ block.id }} {
    display: {{ display_desktop }};
    flex-direction: row;
    {%- if inherit_color_scheme == false and scheme %}
    {% render 'blk-scheme-vars', scheme: scheme %}
    background-color: var(--color-background);
    {%- endif %}
    gap: {{ block.settings.gap }}px;
    justify-content: {{ justify }};
    align-items: {{ align }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    border-radius: {{ block.settings.corner_radius }}px;
    min-height: {% if block.settings.min_height > 0 %}{{ block.settings.min_height }}px{% else %}auto{% endif %};
    max-width: {{ max_width }};
    min-width: {{ min_width }};
    {%- if anchor_id != blank %}
    position: relative;
    {%- endif %}
    {%- if block.settings.wrap %}
    flex-wrap: wrap;
    {%- endif %}
    {%- case block.settings.width %}
      {%- when 'fill' %}
    flex-grow: 1;
    flex-basis: 0;
      {%- when 'custom' %}
    width: {{ custom_width }};
    {%- endcase %}
  }

  {%- if anchor_id != blank %}
  #shopify-block-{{ block.id }} > .blk-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    scroll-margin-top: {{ block.settings.anchor_offset }}px;
  }
  {%- endif %}

  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      display: {{ display_mobile }};
      gap: {{ block.settings.gap_mobile }}px;
      justify-content: {{ justify_mobile }};
      align-items: {{ align_mobile }};
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
      max-width: {{ max_width_mobile }};
      min-width: {{ min_width_mobile }};
      {%- if block.settings.stack_mobile %}
        {%- if block.settings.reverse_mobile %}
      flex-direction: column-reverse;
        {%- else %}
      flex-direction: column;
        {%- endif %}
      {%- endif %}
      {%- case width_mobile %}
        {%- when 'fill' %}
      flex-grow: 1;
      flex-basis: 0;
        {%- when 'custom' %}
      width: {{ custom_width_mobile }};
      {%- endcase %}
    }
  }
{% endstyle %}
{%- if anchor_id != blank %}
  <span id="{{ anchor_id }}" class="blk-anchor" aria-hidden="true"></span>
{%- endif %}
{% content_for 'blocks' %}

{% schema %}
{
  "name": "Flex row",
  "settings": [
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Anchor link"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID",
      "info": "Lets buttons on this page link to this block, e.g. set this to \"pricing\" then point a button's link to #pricing"
    },
    {
      "type": "number",
      "id": "anchor_offset",
      "label": "Offset",
      "default": 0,
      "info": "Vertical offset in pixels applied when scrolling to this ID, useful to account for a sticky header",
      "visible_if": "{{ block.settings.anchor_id != blank }}"
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "space_between", "label": "Space between" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ],
      "default": "stretch"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "Allow items to wrap",
      "default": false,
      "info": "Items move to a new line when they don't fit"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "fit", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill",
      "info": "How this row shares space when placed inside another row or column"
    },
    {
      "type": "text",
      "id": "custom_width",
      "label": "Custom width",
      "default": "100%",
      "info": "Any CSS size: 50%, 300px, 40vw, calc(100% - 40px). Plain numbers are treated as %",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Max width",
      "info": "Any CSS size: 600px, 80vw, calc(100% - 40px). Plain numbers are treated as %. Leave empty for no limit"
    },
    {
      "type": "text",
      "id": "min_width",
      "label": "Min width",
      "info": "Any CSS size: 200px, 20vw. Plain numbers are treated as %. Leave empty for no minimum"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "0 means automatic"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Paddings",
      "info": "In pixels"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right",
      "label": "Padding right",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "Stack vertically on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reverse_mobile",
      "label": "Reverse item order on mobile",
      "default": false,
      "info": "Only applies when items are stacked vertically on mobile",
      "visible_if": "{{ block.settings.stack_mobile }}"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between items",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "Horizontal alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "space_between", "label": "Space between" }
      ],
      "default": "left",
      "info": "When stacked, 'Space between' behaves as 'Stretch'"
    },
    {
      "type": "select",
      "id": "vertical_alignment_mobile",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "space_between", "label": "Space between" }
      ],
      "default": "top",
      "info": "When not stacked, 'Space between' behaves as 'Stretch'"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width",
      "options": [
        { "value": "default", "label": "Same as desktop" },
        { "value": "fill", "label": "Fill available space" },
        { "value": "fit", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "info": "Any CSS size: 50%, 300px, 40vw, calc(100% - 40px). Plain numbers are treated as %. Leave empty to use the desktop custom width",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "text",
      "id": "max_width_mobile",
      "label": "Max width",
      "info": "Any CSS size: 600px, 80vw. Plain numbers are treated as %. Leave empty to use the same max-width as desktop"
    },
    {
      "type": "text",
      "id": "min_width_mobile",
      "label": "Min width",
      "info": "Any CSS size: 200px, 20vw. Plain numbers are treated as %. Leave empty to use the same min-width as desktop"
    },
    {
      "type": "header",
      "content": "Paddings",
      "info": "In pixels"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left_mobile",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right_mobile",
      "label": "Padding right",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "blk_flex-row"
    },
    {
      "type": "blk_flex-col"
    },
    {
      "type": "blk_richtext"
    },
    {
      "type": "blk_background-image"
    },
    {
      "type": "blk_button-cat-1"
    },
    {
      "type": "blk_button-cat-2"
    },
    {
      "type": "blk_image"
    },
    {
      "type": "blk_divider"
    },
    {
      "type": "blk_product-card"
    },
    {
      "type": "blk_blog-carousel"
    }
  ],
  "presets": [
    {
      "name": "Flex row",
      "category": "Layout"
    },
    {
      "name": "Image and text split",
      "category": "Layout",
      "settings": {
        "horizontal_alignment": "center",
        "padding_top_mobile": 36,
        "padding_bottom_mobile": 36
      },
      "blocks": {
        "flex_row_max_width": {
          "type": "blk_flex-row",
          "settings": {
            "horizontal_alignment": "center",
            "vertical_alignment": "middle",
            "max_width": "1400px",
            "padding_top": 100,
            "padding_bottom": 100,
            "gap_mobile": 24,
            "horizontal_alignment_mobile": "stretch",
            "width_mobile": "custom",
            "custom_width_mobile": "100%"
          },
          "blocks": {
            "flex_col_title_mobile": {
              "type": "blk_flex-col",
              "settings": {
                "show_desktop": false,
                "width_mobile": "fill"
              },
              "blocks": {
                "richtext_title_mobile": {
                  "type": "blk_richtext",
                  "settings": {
                    "richtext": "<h1>Heading</h1>",
                    "padding_top_mobile": 40,
                    "padding_bottom_mobile": 20,
                    "padding_left_mobile": 24,
                    "padding_right_mobile": 24
                  }
                }
              },
              "block_order": ["richtext_title_mobile"]
            },
            "flex_col_image": {
              "type": "blk_flex-col",
              "settings": {
                "width": "custom",
                "max_width": "50%",
                "width_mobile": "custom",
                "custom_width_mobile": "100%",
                "min_width_mobile": "100%"
              },
              "blocks": {
                "image_1": {
                  "type": "blk_image",
                  "settings": {
                    "width_mobile": "custom",
                    "custom_width_mobile": "100%"
                  }
                }
              },
              "block_order": ["image_1"]
            },
            "flex_col_text": {
              "type": "blk_flex-col",
              "settings": {
                "width": "custom",
                "max_width": "50%",
                "gap_mobile": 20,
                "width_mobile": "custom",
                "custom_width_mobile": "100%",
                "min_width_mobile": "100%",
                "padding_left_mobile": 25,
                "padding_right_mobile": 25
              },
              "blocks": {
                "flex_col_text_stack": {
                  "type": "blk_flex-col",
                  "settings": {
                    "gap": 24,
                    "horizontal_alignment": "left",
                    "width": "custom",
                    "custom_width": "600px",
                    "padding_left": 48,
                    "gap_mobile": 12,
                    "horizontal_alignment_mobile": "center",
                    "width_mobile": "custom",
                    "max_width_mobile": "100%"
                  },
                  "blocks": {
                    "flex_col_title_desktop": {
                      "type": "blk_flex-col",
                      "settings": {
                        "show_mobile": false,
                        "width_mobile": "fill"
                      },
                      "blocks": {
                        "richtext_title_desktop": {
                          "type": "blk_richtext",
                          "settings": {
                            "richtext": "<h2>Heading</h2>"
                          }
                        }
                      },
                      "block_order": ["richtext_title_desktop"]
                    },
                    "richtext_paragraph_1": {
                      "type": "blk_richtext",
                      "settings": {
                        "richtext": "<p>Add your text here.</p>"
                      }
                    },
                    "richtext_paragraph_2": {
                      "type": "blk_richtext",
                      "settings": {
                        "richtext": "<p>Add your text here.</p>"
                      }
                    },
                    "button_1": {
                      "type": "blk_button-cat-1",
                      "settings": {
                        "width": "260px",
                        "alignment": "left"
                      }
                    }
                  },
                  "block_order": [
                    "flex_col_title_desktop",
                    "richtext_paragraph_1",
                    "richtext_paragraph_2",
                    "button_1"
                  ]
                }
              },
              "block_order": ["flex_col_text_stack"]
            }
          },
          "block_order": [
            "flex_col_title_mobile",
            "flex_col_image",
            "flex_col_text"
          ]
        }
      },
      "block_order": ["flex_row_max_width"]
    }
  ]
}
{% endschema %}
