{% liquid
  assign image = block.settings.image
  assign image_mobile = block.settings.image_mobile
  assign alt = block.settings.alt
  if alt == blank
    assign alt = image.alt | default: ''
  endif

  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
  assign widths_list = widths | split: ', '
  assign sizes = 'auto, (min-width: 750px) 100vw, 100vw'

  assign custom_width = block.settings.custom_width | strip
  assign width_check = custom_width | plus: 0 | append: ''
  if width_check == custom_width and custom_width != blank
    assign custom_width = custom_width | append: '%'
  endif
  assign custom_width = custom_width | escape
  if custom_width == blank
    assign custom_width = 'auto'
  endif

  assign width_mobile = block.settings.width_mobile
  if width_mobile == 'default'
    assign width_mobile = block.settings.width
    assign custom_width_mobile = custom_width
  else
    assign custom_width_mobile = block.settings.custom_width_mobile | strip
    assign width_check = custom_width_mobile | plus: 0 | append: ''
    if width_check == custom_width_mobile and custom_width_mobile != blank
      assign custom_width_mobile = custom_width_mobile | append: '%'
    endif
    assign custom_width_mobile = custom_width_mobile | escape
    if custom_width_mobile == blank
      assign custom_width_mobile = custom_width
    endif
  endif

  assign max_width = block.settings.max_width | strip
  assign width_check = max_width | plus: 0 | append: ''
  if width_check == max_width and max_width != blank
    assign max_width = max_width | append: '%'
  endif
  assign max_width = max_width | escape
  if max_width == blank
    assign max_width = 'none'
  endif

  assign min_width = block.settings.min_width | strip
  assign width_check = min_width | plus: 0 | append: ''
  if width_check == min_width and min_width != blank
    assign min_width = min_width | append: '%'
  endif
  assign min_width = min_width | escape
  if min_width == blank
    assign min_width = '0'
  endif

  assign max_width_mobile = block.settings.max_width_mobile | strip
  assign width_check = max_width_mobile | plus: 0 | append: ''
  if width_check == max_width_mobile and max_width_mobile != blank
    assign max_width_mobile = max_width_mobile | append: '%'
  endif
  assign max_width_mobile = max_width_mobile | escape
  if max_width_mobile == blank
    assign max_width_mobile = max_width
  endif

  assign min_width_mobile = block.settings.min_width_mobile | strip
  assign width_check = min_width_mobile | plus: 0 | append: ''
  if width_check == min_width_mobile and min_width_mobile != blank
    assign min_width_mobile = min_width_mobile | append: '%'
  endif
  assign min_width_mobile = min_width_mobile | escape
  if min_width_mobile == blank
    assign min_width_mobile = min_width
  endif

  assign display_desktop = 'block'
  if block.settings.show_desktop == false
    assign display_desktop = 'none'
  endif

  assign display_mobile = 'block'
  if block.settings.show_mobile == false
    assign display_mobile = 'none'
  endif

  if block.settings.prioritize
    assign loading_value = 'eager'
    assign fetchpriority_value = 'high'
  else
    assign loading_value = 'lazy'
    assign fetchpriority_value = 'auto'
  endif

  assign show_placeholder = false
  if image == blank and request.design_mode
    assign show_placeholder = true
  endif
%}
{% if image_mobile %}
  {%- capture mobile_srcset -%}
    {%- for w in widths_list -%}
      {{ image_mobile | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  {%- endcapture -%}
  {% assign mobile_srcset = mobile_srcset | strip %}
{% endif %}
{% style %}
  #shopify-block-{{ block.id }} {
    display: {{ display_desktop }};
    max-width: {{ max_width }};
    min-width: {{ min_width }};
    min-height: {% if block.settings.min_height > 0 %}{{ block.settings.min_height }}px{% elsif show_placeholder %}150px{% else %}auto{% endif %};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    border-radius: {{ block.settings.corner_radius }}px;
    overflow: hidden;
    {%- case block.settings.width %}
      {%- when 'fill' %}
    width: 100%;
      {%- when 'custom' %}
    width: {{ custom_width }};
    {%- endcase %}
    {%- if show_placeholder %}
    outline: 2px dashed rgba(0, 0, 0, 0.25);
    outline-offset: -2px;
    {%- endif %}
  }

  #shopify-block-{{ block.id }} > a,
  #shopify-block-{{ block.id }} > picture {
    display: block;
    width: 100%;
    {%- if block.settings.min_height > 0 %}
    height: 100%;
    {%- endif %}
  }

  #shopify-block-{{ block.id }} img {
    display: block;
    width: 100%;
    {%- if block.settings.min_height > 0 %}
    height: 100%;
    {%- endif %}
    object-fit: {{ block.settings.object_fit }};
    object-position: {{ block.settings.object_position }};
  }

  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      display: {{ display_mobile }};
      max-width: {{ max_width_mobile }};
      min-width: {{ min_width_mobile }};
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
      {%- case width_mobile %}
        {%- when 'fill' %}
      width: 100%;
        {%- when 'custom' %}
      width: {{ custom_width_mobile }};
      {%- endcase %}
    }
  }
{% endstyle %}
{% if image %}
  {% if block.settings.link != blank %}
    <a
      href="{{ block.settings.link }}"
      {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
      {{ block.shopify_attributes }}
    >
      <picture>
        {% if image_mobile %}
          <source media="(max-width: 749px)" srcset="{{ mobile_srcset }}" sizes="{{ sizes }}">
        {% endif %}
        {{
          image
          | image_url: width: 3840
          | image_tag:
            width: image.width,
            height: image.height,
            widths: widths,
            sizes: sizes,
            alt: alt,
            loading: loading_value,
            fetchpriority: fetchpriority_value
        }}
      </picture>
    </a>
  {% else %}
    <picture {{ block.shopify_attributes }}>
      {% if image_mobile %}
        <source media="(max-width: 749px)" srcset="{{ mobile_srcset }}" sizes="{{ sizes }}">
      {% endif %}
      {{
        image
        | image_url: width: 3840
        | image_tag:
          width: image.width,
          height: image.height,
          widths: widths,
          sizes: sizes,
          alt: alt,
          loading: loading_value,
          fetchpriority: fetchpriority_value
      }}
    </picture>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)",
      "info": "Leave empty to use the same image as desktop. Use this for a differently cropped image on small screens"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text",
      "info": "Leave empty to use the image's own alt text, or none if decorative"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "header",
      "content": "Image settings"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover",
      "info": "Contain may leave empty space when a minimum height is set"
    },
    {
      "type": "select",
      "id": "object_position",
      "label": "Image position",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right center", "label": "Right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ],
      "default": "center",
      "info": "Which part of the image stays visible when it gets cropped"
    },
    {
      "type": "checkbox",
      "id": "prioritize",
      "label": "Prioritize loading",
      "default": false,
      "info": "Turn on for images visible without scrolling, such as above-the-fold banners. Leave off for images further down the page so they load lazily"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "fit", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill",
      "info": "How this image shares space when placed inside a row or column"
    },
    {
      "type": "text",
      "id": "custom_width",
      "label": "Custom width",
      "default": "100%",
      "info": "Any CSS size: 50%, 300px, 40vw, calc(100% - 40px). Plain numbers are treated as %",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Max width",
      "info": "Any CSS size: 600px, 80vw, calc(100% - 40px). Plain numbers are treated as %. Leave empty for no limit"
    },
    {
      "type": "text",
      "id": "min_width",
      "label": "Min width",
      "info": "Any CSS size: 200px, 20vw. Plain numbers are treated as %. Leave empty for no minimum"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "0 means automatic (the image's natural height). When set, the image is cropped/fitted to this height using the Fit setting above"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right",
      "label": "Padding right",
      "default": 0
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width",
      "options": [
        { "value": "default", "label": "Same as desktop" },
        { "value": "fill", "label": "Fill available space" },
        { "value": "fit", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "custom_width_mobile",
      "label": "Custom width",
      "info": "Any CSS size: 50%, 300px, 40vw, calc(100% - 40px). Plain numbers are treated as %. Leave empty to use the desktop custom width",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "text",
      "id": "max_width_mobile",
      "label": "Max width",
      "info": "Any CSS size: 600px, 80vw. Plain numbers are treated as %. Leave empty to use the same max-width as desktop"
    },
    {
      "type": "text",
      "id": "min_width_mobile",
      "label": "Min width",
      "info": "Any CSS size: 200px, 20vw. Plain numbers are treated as %. Leave empty to use the same min-width as desktop"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_left_mobile",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_right_mobile",
      "label": "Padding right",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image",
      "category": "Custom blocks"
    }
  ]
}
{% endschema %}
