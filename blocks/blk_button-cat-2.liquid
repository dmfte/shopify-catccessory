{% liquid
  for scheme in settings.color_schemes
    if scheme.id == 'scheme-1'
      assign cat_scheme = scheme
      break
    endif
  endfor
%}
{% style %}
  #shopify-block-{{ block.id }} {
    {% render 'blk-scheme-vars', scheme: cat_scheme %}
    --cat-path-filled-rest: from 34px 12px, curve to 13px 58px with 10px 12px / 3px 35px, line to 18px 53px, curve to 29px 53px with 22px 55px / 25px 55px, line to 34px 58px, curve to 38px 47px with 37px 55px / 38px 51px, hline to calc({{ block.settings.width }} - 26px), curve by 14px -13px with 6px 0px / 14px -4px, curve by 2px -20px with 7px -5px / 10px -14px, curve by 0px -6px with -2px -2px / -4px -6px, curve by 0px -4px with 3px 0px / 3px -4px, curve by -4px 11px with -5px 1px / -9px 4px, curve by 2px 14px with 5px 7px / 5px 10px, curve by -14px -13px with 0px -9px / -7px -16px, curve by 3px -6px with 5px -3px / 5px -3px, curve by -3px -5px with -2px -4px / -2px -3px, curve by -4px -1px with 3px -5px / -4px -5px, curve by 2px 8px with 0px 2px / 1px 5px, curve by -4px 12px with -8px 2px / -8px 5px, curve by 2px -12px with -4px -6px / -5px -9px, hline to 42px, line to 45px 15px, line to 42px 12px, curve to 43px 11px with 40px 10px / 40px 9px, curve to 43px 5px with 46px 13px / 49px 7px, curve to 40px 18px with 35px 3px / 31px 8px, curve to 36px 12px with 39px 17px / 38px 16px, hline to 34px, move to 17px 18px, curve to 10px 13px with 14px 16px / 12px 15px, curve to 14px 9px with 3px 7px / 13px 4px, curve to 23px 14px with 16px 11px / 21px 13px, move to calc({{ block.settings.width }} - 41px) 12px, curve by -6px -1px with -4px 0px / -4px 0px, curve by 4px -4px with -7px -6px / 5px -9px, curve by 12px 5px with 5px 3px / 7px 3px, hline by -8px;
    --cat-path-filled-waggle: from 34px 12px, curve to 13px 58px with 10px 12px / 3px 35px, line to 18px 53px, curve to 29px 53px with 22px 55px / 25px 55px, line to 34px 58px, curve to 38px 47px with 37px 55px / 38px 51px, hline to calc({{ block.settings.width }} - 26px), curve by 14px -13px with 6px 0px / 14px -4px, curve by 2px -20px with 7px -5px / 10px -14px, curve by 0px -6px with -2px -2px / -4px -6px, curve by 0px -4px with 3px 0px / 3px -4px, curve by -4px 11px with -5px 1px / -9px 4px, curve by 2px 14px with 5px 7px / 5px 10px, curve by -10px -17px with 0px -9px / -7px -17px, curve by -1px -5px with 1px -2px / 1px -4px, curve by -8px -4px with -4px -2px / -7px -3px, curve by -5px 0px with 0px -2px / -5px -3px, curve by 9px 7px with 0px 2px / 4px 5px, curve by -5px 14px with -9px 4px / -9px 7px, curve by 1px -12px with -4px -7px / -2px -10px, hline to 42px, line to 45px 15px, line to 42px 12px, curve to 44px 8px with 40px 9px / 43px 8px, curve to 42px 3px with 49px 7px / 47px 1px, curve to 40px 18px with 36px 5px / 31px 8px, curve to 36px 12px with 39px 17px / 38px 16px, hline to 34px, move to 18px 17px, curve to 11px 9px with 15px 15px / 13px 13px, curve to 16px 7px with 9px 4px / 14px 3px, curve to 24px 14px with 17px 10px / 21px 13px, move to calc({{ block.settings.width }} - 40px) 12px, curve by -3px -3px with -2px -2px / -3px -3px, curve by 4px -4px with -5px -5px / 3px -9px, curve by 8px 7px with 2px 3px / 5px 5px, hline by -9px;
    width: {{ block.settings.width }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
  }
  {% comment %}Scoped to this block: .cat-btn is shared with blk_button-cat-1 (40px tall){% endcomment %}
  #shopify-block-{{ block.id }} .cat-btn {
    height: 60px;
  }
  #shopify-block-{{ block.id }} .cat-shape {
    padding-top: 0;
  }
  @media screen and (max-width: 749px) {
    #shopify-block-{{ block.id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
    }
  }
{% endstyle %}

{% stylesheet %}
  .cat-btn {
    display: block;
    position: relative;
    width: 100%;
    height: 40px;
    text-decoration: none;

    & .cat-shape {
      position: absolute;
      top: 0;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: 8px;
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      font-size: 16px;
      line-height: 1;
      background-color: var(--color-primary-button-background);
      color: var(--color-primary-button-text);
      transition: background-color 150ms ease, color 150ms ease;
      clip-path: shape(var(--cat-path-filled-rest));
    }

    &:hover {
      & .cat-shape {
        background-color: var(--color-primary-button-hover-background);
        color: var(--color-primary-button-hover-text);
        animation: cat-tail-waggle 600ms ease-in-out;
      }
    }

    &.cat-btn--secondary {
      & .cat-shape {
        background-color: var(--color-secondary-button-background);
        color: var(--color-secondary-button-text);
      }

      &:hover .cat-shape {
        background-color: var(--color-secondary-button-hover-background);
        color: var(--color-secondary-button-hover-text);
      }
    }
  }

  @keyframes cat-tail-waggle {
    0% {
      clip-path: shape(var(--cat-path-filled-rest));
    }
    50% {
      clip-path: shape(var(--cat-path-filled-waggle));
    }
    100% {
      clip-path: shape(var(--cat-path-filled-rest));
    }
  }
{% endstylesheet %}
<a
  href="{{ block.settings.link | default: '#' }}"
  class="cat-btn{% if block.settings.style == 'secondary' %} cat-btn--secondary{% endif %}{% if block.settings.animate_tail %} cat-btn--animated{% endif %}"
  {% if block.settings.open_in_new_tab %}
    target="_blank" rel="noopener"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <span class="cat-shape">{{ block.settings.label | escape }}</span>
</a>

{% schema %}
